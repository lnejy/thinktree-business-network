# Local dependencies, secrets, runtime output and editor settings
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!**/.env.example
**/.vite/
**/dist/
**/test-results/
**/.vscode/
**/*.log
**/.DS_Store
/backend/runtime/

# Ground-truth labels remain local; supplied originals and OCR reports are tracked
/backend/gt/*
!/backend/gt/.gitkeep
/backend/gt_fields/
